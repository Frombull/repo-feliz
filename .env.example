ENVIRONMENT=development
API_PORT=8000
FRONTEND_PORT=5173

# URL da API vista pelo navegador (vai embutida no build do frontend)
VITE_API_URL=http://localhost:8000

# Origens do frontend autorizadas no CORS, separadas por virgula (nunca use *)
CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# usado ao rodar a API fora do Docker (make run, make migrate)
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/app
